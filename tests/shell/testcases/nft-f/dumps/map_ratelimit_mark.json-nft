{
  "nftables": [
    {
      "metainfo": {
        "version": "VERSION",
        "release_name": "RELEASE_NAME",
        "json_schema_version": 1
      }
    },
    {
      "table": {
        "family": "ip",
        "name": "t",
        "handle": 0
      }
    },
    {
      "chain": {
        "family": "ip",
        "table": "t",
        "name": "c",
        "handle": 0
      }
    },
    {
      "map": {
        "family": "ip",
        "name": "m",
        "table": "t",
        "type": "ipv4_addr",
        "handle": 0,
        "map": "mark",
        "size": 65535,
        "flags": [
          "timeout",
          "dynamic"
        ],
        "timeout": 60
      }
    },
    {
      "rule": {
        "family": "ip",
        "table": "t",
        "chain": "c",
        "handle": 0,
        "expr": [
          {
            "map": {
              "op": "add",
              "elem": {
                "payload": {
                  "protocol": "ip",
                  "field": "saddr"
                }
              },
              "data": {
                "meta": {
                  "key": "mark"
                }
              },
              "map": "@m",
              "stmt": [
                {
                  "limit": {
                    "rate": 1,
                    "burst": 1,
                    "per": "second"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
